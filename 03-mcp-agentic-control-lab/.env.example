# ==============================================================================
# AI BRAIN (Local Ollama GPU instance / GCP VM / OpenAI)
# ==============================================================================
AI_BRAIN_BASE_URL=http://localhost:11434/v1
AI_BRAIN_MODEL=deepseek-r1:32b
AI_BRAIN_API_KEY=ollama

# Optional: Fallback OpenAI API Key (if AI_BRAIN_BASE_URL is unreachable)
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# VECTOR STORE (chroma OR pinecone)
# ==============================================================================
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=./chroma_db

# Pinecone settings (only needed if VECTOR_STORE_PROVIDER=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_REGION=us-east-1
PINECONE_INDEX_NAME=mcp-rag-index

# ==============================================================================
# ROLE-BASED ACCESS CONTROL IDENTITY DEFAULTS
# ==============================================================================
ADMIN_EMAIL=xyz@gmail.com
USER_EMAIL=abc@gmail.com
