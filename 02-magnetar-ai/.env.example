ENVIRONMENT=production
API_KEY=your-strong-api-key-here
CORS_ORIGINS=["https://your-domain.com", "http://<VM_IP>"]
REGION=asia-south1
GCP_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-bucket-name
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change-this-strong-redis-password
# Use host's native Ollama
OLLAMA_URL=http://172.17.0.1:11434
OLLAMA_MODEL=deepseek-r1:32b
INPUT_GUARD_MODEL_PATH=./models/deberta-v3-base-prompt-injection
RATE_LIMIT_PER_MINUTE=50
DEFAULT_TEMPERATURE=0.0
DEFAULT_SEED=42
DEFAULT_MAX_TOKENS=512
CACHE_TTL=3600
CHROMA_PERSIST_DIR=./chroma_data
BM25_DATA_DIR=./bm25_data
MAX_UPLOAD_SIZE_MB=10
# TLS
DOMAIN=your-domain.com
CERTBOT_EMAIL=your-email@example.com
